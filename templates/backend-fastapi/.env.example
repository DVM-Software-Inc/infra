# Compose interpolation vars (required by deploy/docker-compose.yml)
PROJECT_NAME=your-repo-name        # lowercase, = GitHub repo name / deploy slug
# IMAGE_TAG and DEPLOY_ENVIRONMENT are injected by the reusable deploy workflow.
APP_DOMAIN=dev.your-product.com    # per-env host; prod e.g. api.your-product.com

# App configuration — names only; real values live in Vaultwarden -> ENV_FILE secret
APP_ENV=dev
# DATABASE_URL=postgresql://<slug>_<env>:<pw>@postgres:5432/<slug>_<env>   # Vaultwarden: postgres-<slug>-<env>
